generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CITIZEN
  BUSINESS
  RECEPTION_OFFICER
  COMMUNE_OFFICER
  LAND_REGISTRY_OFFICER
  APPROVAL_AUTHORITY
  TAX_OFFICER
  AUDITOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  LOCKED
}

enum WalletStatus {
  PENDING_VERIFICATION
  VERIFIED
  INACTIVE
}

enum BlockchainNetwork {
  SEPOLIA
  HARDHAT
  GANACHE
}

enum ServiceWalletAuthorizationStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum BlockchainTxLifecycleStatus {
  PENDING
  CONFIRMED
  FAILED
  REJECTED
}

enum RegistrationStatus {
  MOI_TAO
  CHO_TIEP_NHAN
  CAN_BO_SUNG
  DA_TIEP_NHAN
  CHO_XAC_NHAN_CAP_XA
  DA_XAC_NHAN_CAP_XA
  DANG_THAM_DINH_VPDKDD
  CHO_THUE
  CHO_HOAN_THANH_NGHIA_VU_TAI_CHINH
  DA_HOAN_THANH_NGHIA_VU_TAI_CHINH
  CHO_KY_CAP
  DA_KY_CAP
  DA_CAP_NHAT_HO_SO_DIA_CHINH
  DA_GHI_BLOCKCHAIN
  DA_CAP
  DA_TRA_KET_QUA
  HUY_HO_SO
  TU_CHOI
}

enum ProcedureLevel {
  XA
  TINH
  LIEN_THONG
}

enum DocumentVersionStatus {
  ACTIVE
  REPLACED
  LOCKED
  INVALIDATED
}

enum PaymentObligationType {
  INTAKE_FEE
  LAND_FINANCIAL_OBLIGATION
  REGISTRATION_FEE
  LATE_FEE
  OTHER_LEGAL_FEE
}

enum PaymentObligationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum LandSourceType {
  DEMO
  IMPORTED
  OFFICIAL_REFERENCE
  UNKNOWN_NEEDS_REVIEW
}

enum ParcelGeometryStatus {
  DRAFT
  UNDER_REVIEW
  OFFCHAIN_APPROVED
  BOUNDARY_HASH_RECORDED
}

enum TransferStatus {
  MOI_TAO_BIEN_DONG
  CHO_TIEP_NHAN
  CAN_BO_SUNG
  DA_TIEP_NHAN
  DANG_KIEM_TRA_DIEU_KIEN
  DA_CHUYEN_THUE
  CHO_HOAN_THANH_NGHIA_VU_TAI_CHINH
  DANG_CAP_NHAT_BIEN_DONG
  DA_DANG_KY_BIEN_DONG
  DA_TRA_KET_QUA
  TU_CHOI
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  fullName       String
  role           UserRole
  status         UserStatus     @default(ACTIVE)
  passwordHash   String
  failedLoginAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  identityNumber String?
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  registrations  Registration[]
  ownedParcels   LandParcel[]   @relation("ParcelOwner")
  sessions       AuthSession[]
  wallets        WalletAccount[]
  serviceWalletAuthorizations ServiceWalletAuthorization[] @relation("ServiceWalletOwner")
  serviceWalletAuthorizationsRevoked ServiceWalletAuthorization[] @relation("ServiceWalletRevokedBy")
  blockchainTxEvents BlockchainTxLifecycle[] @relation("BlockchainTxActor")
  documentVersionsCreated RegistrationDocumentVersion[] @relation("DocVersionCreatedBy")
  submittedSnapshots RegistrationSubmitSnapshot[] @relation("SnapshotSubmittedBy")
  paymentObligationsCreated RegistrationPaymentObligation[] @relation("PaymentCreatedBy")
  paymentObligationsConfirmed RegistrationPaymentObligation[] @relation("PaymentConfirmedBy")
  paymentObligationsVerified RegistrationPaymentObligation[] @relation("PaymentVerifiedBy")
  landGeometryReviewed LandParcel[] @relation("LandGeometryReviewedBy")
  landGeometryApproved LandParcel[] @relation("LandGeometryApprovedBy")
  landBoundaryHashRecorded LandParcel[] @relation("LandBoundaryHashRecordedBy")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model LegalProcedure {
  id              String         @id @default(cuid())
  procedureCode   String         @unique
  sourceDecision  String
  legalBasis      String
  level           ProcedureLevel
  authorityActors Json
  requiresTaxStep Boolean        @default(false)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  registrations   Registration[]
}

model AuthSession {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String
  refreshTokenFingerprint String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([refreshTokenFingerprint, revokedAt, expiresAt])
}

model Organization {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LandParcel {
  id            String   @id @default(cuid())
  parcelCode    String
  provinceCode  String
  communeName   String
  mapSheetNumber String
  parcelNumber  String
  area          Decimal  @db.Decimal(10,2)
  landUsePurpose String
  address       String
  latitude      Decimal? @db.Decimal(10,7)
  longitude     Decimal? @db.Decimal(10,7)
  sourceType    LandSourceType @default(DEMO)
  geometry      Json?
  geometryStatus ParcelGeometryStatus @default(DRAFT)
  geometryReviewedById String?
  geometryReviewedBy User? @relation("LandGeometryReviewedBy", fields: [geometryReviewedById], references: [id], onDelete: SetNull)
  geometryReviewedAt DateTime?
  geometryApprovedById String?
  geometryApprovedBy User? @relation("LandGeometryApprovedBy", fields: [geometryApprovedById], references: [id], onDelete: SetNull)
  geometryOffchainApprovedAt DateTime?
  boundaryHashRecordedById String?
  boundaryHashRecordedBy User? @relation("LandBoundaryHashRecordedBy", fields: [boundaryHashRecordedById], references: [id], onDelete: SetNull)
  boundaryHashRecordedAt DateTime?
  boundaryHashTxHash String?
  boundaryHashCid String?
  boundaryHashValue String?
  ownerUserId   String?
  owner         User?    @relation("ParcelOwner", fields: [ownerUserId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([parcelCode, provinceCode, communeName], name: "land_parcel_unique_code_area")
}

model Registration {
  id             String             @id @default(cuid())
  code           String             @unique
  applicantId    String
  landCode       String?
  provinceCode   String
  communeName    String
  parcelNumber   String
  mapSheetNumber String
  area           Decimal            @db.Decimal(10,2)
  landUsePurpose String
  address        String
  ownerType      String
  ownerFullName  String
  ownerIdentityNumber String?
  ownerAddress   String?
  procedureCode  String?
  legalBasisCode String?
  noteHistory    Json?
  submittedSnapshotLocked Boolean          @default(false)
  cadastralUpdatedAt DateTime?
  status         RegistrationStatus @default(MOI_TAO)
  ipfsCid        String?
  documentHash   String?
  tokenId        Int?
  txHash         String?
  procedure      LegalProcedure?    @relation(fields: [procedureCode], references: [procedureCode])
  applicant      User               @relation(fields: [applicantId], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  files          FileAsset[]
  documentVersions RegistrationDocumentVersion[]
  submitSnapshots RegistrationSubmitSnapshot[]
  paymentObligations RegistrationPaymentObligation[]
  blockchainTxEvents BlockchainTxLifecycle[]

  @@index([procedureCode])
}

model TransferRequest {
  id           String         @id @default(cuid())
  code         String         @unique
  landCode     String
  fromUserId   String?
  toUserRef    String
  status       TransferStatus @default(MOI_TAO_BIEN_DONG)
  supportingCid String?
  supportingHash String?
  txHash       String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model FileAsset {
  id             String   @id @default(cuid())
  ownerType      String
  ownerId        String
  documentType   String
  originalName   String
  storageStatus  String
  cid            String?
  hash           String?
  registrationId String?
  registration   Registration? @relation(fields: [registrationId], references: [id])
  versions       RegistrationDocumentVersion[]
  paymentReceiptObligations RegistrationPaymentObligation[] @relation("PaymentReceiptFile")
  createdAt      DateTime @default(now())
}

model WalletAccount {
  id               String                      @id @default(cuid())
  userId           String
  address          String
  network          BlockchainNetwork
  status           WalletStatus                @default(PENDING_VERIFICATION)
  isDefault        Boolean                     @default(false)
  verifiedAt       DateTime?
  lastVerifiedAt   DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  user             User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenges       WalletVerificationChallenge[]
  serviceAuthorizations ServiceWalletAuthorization[]

  @@unique([network, address], name: "wallet_network_address_unique")
  @@index([userId, network, isDefault])
}

model ServiceWalletAuthorization {
  id             String                           @id @default(cuid())
  walletId       String
  userId         String
  organizationId String?
  roleScope      UserRole
  network        BlockchainNetwork
  chainId        Int
  status         ServiceWalletAuthorizationStatus @default(ACTIVE)
  effectiveFrom  DateTime                         @default(now())
  effectiveTo    DateTime?
  reason         String?
  revokedAt      DateTime?
  revokedById    String?
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt
  wallet         WalletAccount                    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user           User                             @relation("ServiceWalletOwner", fields: [userId], references: [id], onDelete: Cascade)
  revokedBy      User?                            @relation("ServiceWalletRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([network, chainId, status])
  @@index([userId, roleScope, status])
}

model BlockchainTxLifecycle {
  id             String                     @id @default(cuid())
  registrationId String
  actorId        String?
  action         String
  network        BlockchainNetwork
  chainId        Int
  walletAddress  String
  txHash         String?
  explorerUrl    String?
  status         BlockchainTxLifecycleStatus @default(PENDING)
  errorCode      String?
  errorMessage   String?
  payload        Json?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  registration   Registration               @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  actor          User?                      @relation("BlockchainTxActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([registrationId, createdAt])
  @@index([status, network, chainId])
}

model WalletVerificationChallenge {
  id         String        @id @default(cuid())
  walletId   String
  nonce      String
  message    String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime      @default(now())
  wallet     WalletAccount @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, usedAt, expiresAt])
}

model RegistrationDocumentVersion {
  id             String                @id @default(cuid())
  registrationId String
  versionNumber  Int
  documentType   String
  storageStatus  String
  cid            String?
  hash           String?
  status         DocumentVersionStatus @default(ACTIVE)
  note           String?
  fileAssetId    String?
  createdById    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  registration   Registration          @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  fileAsset      FileAsset?            @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  createdBy      User?                 @relation("DocVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([registrationId, versionNumber], name: "registration_document_version_unique")
  @@index([registrationId, status])
}

model RegistrationSubmitSnapshot {
  id                 String       @id @default(cuid())
  registrationId     String
  snapshotNo         Int
  procedureCode      String?
  legalBasisCode     String
  authorityActor     String
  documentVersionIds Json
  submittedById      String
  createdAt          DateTime     @default(now())
  registration       Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  submittedBy        User         @relation("SnapshotSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)

  @@unique([registrationId, snapshotNo], name: "registration_snapshot_unique")
  @@index([registrationId])
}

model RegistrationPaymentObligation {
  id             String                  @id @default(cuid())
  registrationId String
  type           PaymentObligationType
  status         PaymentObligationStatus @default(PENDING)
  legalBasisCode String
  referenceNo    String?
  noticeRef      String?
  noticeIssuedAt DateTime?
  receiptRef     String?
  receiptFileId  String?
  receiptFile    FileAsset?              @relation("PaymentReceiptFile", fields: [receiptFileId], references: [id], onDelete: SetNull)
  receiptSubmittedAt DateTime?
  amount         Decimal?                @db.Decimal(12,2)
  note           String?
  createdById    String
  confirmedById  String?
  confirmedAt    DateTime?
  verifiedById   String?
  verifiedBy     User?                   @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt     DateTime?
  verifyNote     String?
  evidenceTxHash String?
  evidenceCid    String?
  evidenceHash   String?
  evidenceRecordedAt DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  registration   Registration            @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  createdBy      User                    @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedBy    User?                   @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([registrationId, type, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  payload    Json?
  createdAt  DateTime @default(now())
}
