generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CITIZEN
  BUSINESS
  RECEPTION_OFFICER
  COMMUNE_OFFICER
  LAND_REGISTRY_OFFICER
  TAX_OFFICER
  APPROVAL_AUTHORITY
  AUDITOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  LOCKED
}

enum WalletStatus {
  PENDING_VERIFICATION
  VERIFIED
  INACTIVE
}

enum BlockchainNetwork {
  SEPOLIA
  HARDHAT
  GANACHE
}

enum RegistrationStatus {
  MOI_TAO
  CHO_TIEP_NHAN
  CAN_BO_SUNG
  DA_TIEP_NHAN
  CHO_XAC_NHAN_CAP_XA
  DA_XAC_NHAN_CAP_XA
  DANG_THAM_DINH_VPDKDD
  CHO_THUE
  CHO_HOAN_THANH_NGHIA_VU_TAI_CHINH
  DA_HOAN_THANH_NGHIA_VU_TAI_CHINH
  CHO_KY_CAP
  DA_KY_CAP
  DA_CAP_NHAT_HO_SO_DIA_CHINH
  DA_GHI_BLOCKCHAIN
  DA_CAP
  DA_HOAN_THANH_NGHIA_VU_TAI_CHINH
  DA_CAP_NHAT_HO_SO_DIA_CHINH
  DA_GHI_BLOCKCHAIN
  DA_TRA_KET_QUA
  HUY_HO_SO
  TU_CHOI
}

enum PaymentObligationType {
  INTAKE_FEE
  LAND_FINANCIAL_OBLIGATION
}

enum PaymentObligationStatus {
  PENDING
  FULFILLED
  WAIVED
  CANCELED
}

enum TransferStatus {
  MOI_TAO_BIEN_DONG
  CHO_TIEP_NHAN
  CAN_BO_SUNG
  DA_TIEP_NHAN
  DANG_KIEM_TRA_DIEU_KIEN
  DA_CHUYEN_THUE
  CHO_HOAN_THANH_NGHIA_VU_TAI_CHINH
  DANG_CAP_NHAT_BIEN_DONG
  DA_DANG_KY_BIEN_DONG
  DA_TRA_KET_QUA
  TU_CHOI
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  fullName       String
  role           UserRole
  status         UserStatus     @default(ACTIVE)
  passwordHash   String
  failedLoginAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  identityNumber String?
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  registrations  Registration[]
  ownedParcels   LandParcel[]   @relation("ParcelOwner")
  sessions       AuthSession[]
  wallets        WalletAccount[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model LegalProcedure {
  id              String         @id @default(cuid())
  procedureCode   String         @unique
  sourceDecision  String
  legalBasis      String
  level           ProcedureLevel
  authorityActors Json
  requiresTaxStep Boolean        @default(false)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  registrations   Registration[]
}

model AuthSession {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String
  refreshTokenFingerprint String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([refreshTokenFingerprint, revokedAt, expiresAt])
}

model Organization {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LandParcel {
  id            String   @id @default(cuid())
  parcelCode    String
  provinceCode  String
  communeName   String
  mapSheetNumber String
  parcelNumber  String
  area          Decimal  @db.Decimal(10,2)
  landUsePurpose String
  address       String
  latitude      Decimal? @db.Decimal(10,7)
  longitude     Decimal? @db.Decimal(10,7)
  ownerUserId   String?
  owner         User?    @relation("ParcelOwner", fields: [ownerUserId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([parcelCode, provinceCode, communeName], name: "land_parcel_unique_code_area")
}

model Registration {
  id             String             @id @default(cuid())
  code           String             @unique
  applicantId    String
  landCode       String?
  provinceCode   String
  communeName    String
  parcelNumber   String
  mapSheetNumber String
  area           Decimal            @db.Decimal(10,2)
  landUsePurpose String
  address        String
  ownerType      String
  ownerFullName  String
  ownerIdentityNumber String?
  ownerAddress   String?
  procedureCode  String?
  legalBasisCode String?
  submitSnapshotAt DateTime?
  noteHistory    Json?
  submittedSnapshotLocked Boolean          @default(false)
  cadastralUpdatedAt DateTime?
  status         RegistrationStatus @default(MOI_TAO)
  ipfsCid        String?
  documentHash   String?
  tokenId        Int?
  txHash         String?
  procedure      LegalProcedure?    @relation(fields: [procedureCode], references: [procedureCode])
  applicant      User               @relation(fields: [applicantId], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  files          FileAsset[]
  documentVersions RegistrationDocumentVersion[]
  submitSnapshots RegistrationSubmitSnapshot[]
  paymentObligations PaymentObligation[]
}

model TransferRequest {
  id           String         @id @default(cuid())
  code         String         @unique
  landCode     String
  fromUserId   String?
  toUserRef    String
  status       TransferStatus @default(MOI_TAO_BIEN_DONG)
  supportingCid String?
  supportingHash String?
  txHash       String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model FileAsset {
  id             String   @id @default(cuid())
  ownerType      String
  ownerId        String
  documentType   String
  originalName   String
  storageStatus  String
  cid            String?
  hash           String?
  registrationId String?
  registration   Registration? @relation(fields: [registrationId], references: [id])
  versions       RegistrationDocumentVersion[]
  createdAt      DateTime @default(now())
}

model LegalProcedure {
  id                String   @id @default(cuid())
  procedureCode     String   @unique
  name              String
  sourceDecision    String?
  legalBasis        String
  level             String
  authorityActors   Json
  requiresTaxStep   Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model RegistrationDocumentVersion {
  id             String   @id @default(cuid())
  registrationId String
  fileAssetId    String
  documentType   String
  versionNo      Int      @map("versionNumber")
  cid            String?
  hash           String?
  createdBy      String?  @map("createdById")
  createdAt      DateTime @default(now())
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  fileAsset      FileAsset     @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)

  @@unique([registrationId, fileAssetId, versionNo], name: "reg_doc_version_unique")
  @@index([registrationId, documentType, createdAt], name: "reg_doc_reg_docType_createdAt_idx")
}

model RegistrationSubmitSnapshot {
  id                String   @id @default(cuid())
  registrationId    String
  snapshotNo        Int      @default(1)
  submittedBy       String?  @map("submittedById")
  procedureCode     String?
  legalBasisCode    String
  authorityActor    String   @default("RECEPTION_OFFICER")
  fileVersionIds    Json     @map("documentVersionIds")
  fileIds           Json
  createdAt         DateTime @default(now())
  registration      Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId, createdAt])
}

model PaymentObligation {
  id             String                  @id @default(cuid())
  registrationId String
  type           PaymentObligationType
  status         PaymentObligationStatus @default(PENDING)
  amount         Decimal?                @db.Decimal(12,2)
  referenceNo    String?
  note           String?
  createdBy      String?
  fulfilledAt    DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  registration   Registration            @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId, type, status])
}

model WalletAccount {
  id               String                      @id @default(cuid())
  userId           String
  address          String
  network          BlockchainNetwork
  status           WalletStatus                @default(PENDING_VERIFICATION)
  isDefault        Boolean                     @default(false)
  verifiedAt       DateTime?
  lastVerifiedAt   DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  user             User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenges       WalletVerificationChallenge[]

  @@unique([network, address], name: "wallet_network_address_unique")
  @@index([userId, network, isDefault])
}

model WalletVerificationChallenge {
  id         String        @id @default(cuid())
  walletId   String
  nonce      String
  message    String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime      @default(now())
  wallet     WalletAccount @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, usedAt, expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  payload    Json?
  createdAt  DateTime @default(now())
}
